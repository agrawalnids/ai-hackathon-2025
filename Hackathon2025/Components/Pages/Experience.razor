@page "/experience"
@using Hackathon2025.Abstractions
@using OpenAI
@using OpenAI.Chat
@using System.ClientModel
@using System.Text.Json
@inject OnboardingAgentService AgentService
@inject VectorStoreService VectorStoreService
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<PageTitle>Experience</PageTitle>
    @if (Model != null)
    {
        if (Model.DiscoveryFeed != null)
        {
            //timed experience
            <div id="timer" class="timer">05:00</div>
        }
        <div class="mood-setter-wrp">
            @foreach(var mood in Model.ExperienceMoods)
            {
                <button @onclick="() => SetCurrentMood(mood)"><img src='@String.Format("/images/icon-{0}.png", mood)' /></button>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.MoodAudio))
        {

            <div class="mood-music-wrp">
                @((MarkupString)Model.MoodAudio)
                <button @onclick='() => ToggleMoodAudio("play")' class="__play"><img src="/images/icon-audio.png" /></button>
                <button @onclick='() => ToggleMoodAudio("stop")'  class="__stop __hide"><img src="/images/icon-mute-audio.png" /></button>
            </div>
        }
    @if (Model.DiscoveryFeed != null)
    {
        <div class="content-wrp __scrollable">

            @* //present activity gallery *@
            @foreach (var item in Model.DiscoveryFeed)
            {
                <div class="card">
                    <iframe src="@item.URL"  title="@item.Title"></iframe>
                    <div class="row">
                        <div class="col">
                            <p class="title">@item.Title</p>
                            <p class="description">@item.Summary</p>
                        </div>
                    </div>
                    <div class="btns-rate-wrp">
                        <button @onclick='() => SavePostToInterests(item)' class="like"></button>
                        <a href="#" class="dislike" title="Dislike"></a>
                    </div>
                </div>
            }

        </div>
    }
}

<LoadingOverlay ShowOnLoadClass="__active" />

@code {
    public ExperienceViewModel? Model { get; set; }
    public ChatClient? Client { get; set; }
    public DotNetObjectReference<Experience>? DotNetReference { get; set; }
    public ChatCompletionOptions? Options { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new(); //init model


        var timeUtc = DateTime.UtcNow;
        TimeZoneInfo easternZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
        DateTime easternTime = TimeZoneInfo.ConvertTimeFromUtc(timeUtc, easternZone);

        Model.IsProductivityMode = (easternTime.Hour > 8 && easternTime.Hour < 17);

        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GenerateDiscoveryFeed();
            DotNetReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("startTimer", DotNetReference);
        }
    }

    private async Task SetupMood()
    {
        var endpoint = Configuration["GithubOpenAI:ChatEndpoint"];
        var credential = Configuration["GithubOpenAI:Token"];
        var model = Configuration["GithubOpenAI:Model"];

        //get user likes & user dislikes from vector DB to add context
        string userOnboardingInterestsContext = "Get all user likes and interests";

        Dictionary<string, object> results = await VectorStoreService.QueryOnboardingResultVectorStoreAsync(userOnboardingInterestsContext);

        string onboardingContext = string.Empty;

        foreach (var item in results)
        {
            onboardingContext += item.Key + ": " + item.Value.ToString().Replace("[", string.Empty).Replace("]", string.Empty);
        }


        var experienceConfigPrompt = String.Format("You are a Mental Health expert with over 20 years of experience with specialization in mood. Your goal is to recommend a background colour, a song (a youtube iframe embed link to it) that would improve the my mood when I am feeling {0}. My interests and likes are {1}. Based on the provided context, make the best recommendations.", Model.CurrentMood, onboardingContext);


        var openAIOptions = new OpenAIClientOptions()
            {
                Endpoint = new Uri(endpoint)
            };

        Client = new ChatClient(model, new ApiKeyCredential(credential), openAIOptions);

        Model.ExperienceChatHistory = new List<ChatMessage>()
        {
            new SystemChatMessage(experienceConfigPrompt),
            new AssistantChatMessage(Model.ExperienceGreeting),
            new UserChatMessage(Model.CurrentMood)
        };

        string jsonSchema = @"
        {
            ""type"": ""object"",
            ""properties"": {
                ""backgroundcolour"": { ""type"": ""string"" },
                ""song"": { ""type"": ""string"" }
            },
            ""required"": [""backgroundcolour"", ""song""],
            ""additionalProperties"": false
        }
        ";

        Options = new()
            {
                ResponseFormat = ChatResponseFormat.CreateJsonSchemaFormat(
                    jsonSchemaFormatName: "experience_setup",
                    jsonSchema: BinaryData.FromString(jsonSchema),
                    jsonSchemaIsStrict: true)
            };

        ChatCompletion response1 = await Client.CompleteChatAsync(Model.ExperienceChatHistory, Options);


        using JsonDocument structuredJson = JsonDocument.Parse(response1.Content[0].Text);

        var bgColor = structuredJson.RootElement.GetProperty("backgroundcolour").ToString();
        await JSRuntime.InvokeVoidAsync("updateBackgroundColor", bgColor);

        Model.MoodAudio = structuredJson.RootElement.GetProperty("song").ToString();

        StateHasChanged();
        await Task.CompletedTask;
    }

    [JSInvokable("ProcessInterests")]
    public async Task ProcessInterests()
    {
        await JSRuntime.InvokeVoidAsync("showLoader");

        var profileName = await JSRuntime.InvokeAsync<string>("getCookie", "profileName");
        //save all interests
        List<VectorDataModel> likedInterests = new List<VectorDataModel>();

        foreach (ContentItemModel post in Model.LikedPosts)
        {
            likedInterests.Add(new VectorDataModel()
                {
                    Data = post.ContentType + post.Title + post.Summary,
                    MetaData = new Dictionary<string, object>
                    {
                        ["Category"] = post.Category,
                        ["Description"] = post.Description,
                        ["Label"] = post.Title,
                        ["UserName"] = profileName
                    }
                });
        }


        await VectorStoreService.SaveToVectorStoreAsync(likedInterests);

        //save all dislikes
        List<VectorDataModel> dislikedInterests = new List<VectorDataModel>();

        foreach (ContentItemModel post in Model.DislikedPosts)
        {
            dislikedInterests.Add(new VectorDataModel()
                {
                    Data = post.ContentType + post.Title + post.Summary,
                    MetaData = new Dictionary<string, object>
                    {
                        ["Category"] = "Dislikes",
                        ["Description"] = post.Description,
                        ["Label"] = post.Title,
                        ["UserName"] = profileName
                    }
                });
        }
        await VectorStoreService.SaveToVectorStoreAsync(dislikedInterests);

        //redirect to times up

        NavigationManager.NavigateTo("/see-you-later");
    }

    private async Task SavePostToInterests(ContentItemModel post)
    {
        var profileName = await JSRuntime.InvokeAsync<string>("getCookie", "profileName");

        Model.LikedPosts.Add(post);


        if (Model.DislikedPosts.Count > 0)
        {
            if (Model.DislikedPosts.Contains(post))
            {
                Model.DislikedPosts.Remove(post);
            }
        }

        StateHasChanged();

        await Task.CompletedTask;

    }

    private async Task RemovePostFromInterests(ContentItemModel post)
    {
        var profileName = await JSRuntime.InvokeAsync<string>("getCookie", "profileName");

        Model.DislikedPosts.Add(post);

        if (Model.LikedPosts.Count > 0)
        {
            if (Model.LikedPosts.Contains(post))
            {
                Model.LikedPosts.Remove(post);
            }
        }


        StateHasChanged();

        await Task.CompletedTask;

    }

    public void Dispose()
    {
        GC.SuppressFinalize(this);

        if (DotNetReference != null)
        {
            DotNetReference.Dispose();
        }
    }


    private async Task GenerateDiscoveryFeed()
    {
        //empty feed
        Model.DiscoveryFeed = new List<ContentItemModel>();

        var endpoint = Configuration["GithubOpenAI:ChatEndpoint"];
        var credential = Configuration["GithubOpenAI:Token"];
        var model = Configuration["GithubOpenAI:Model"];

        string userLikesInterests = "Get user's personal interests and professional interests";

        Dictionary<string, object> results = await VectorStoreService.QueryOnboardingResultVectorStoreAsync(userLikesInterests);

        string onboardingContext = String.Empty;

        foreach (var item in results)
        {
            onboardingContext += String.Format("{0}. ", item.Key.ToString().Replace("[", string.Empty).Replace("]", string.Empty));
        }


        string userDislikedInterests = "Get information of all the records that have been labelled as Dislikes";

        Dictionary<string, object> dislikeResults = await VectorStoreService.QueryOnboardingResultVectorStoreAsync(userDislikedInterests);

        string dislikeContext = String.Empty;

        foreach (var item in dislikeResults)
        {
            dislikeContext += String.Format("{0}. ", item.Key.ToString().Replace("[", string.Empty).Replace("]", string.Empty));
        }

        var openAIOptions = new OpenAIClientOptions()
        {
            Endpoint = new Uri(endpoint)
        };

        Client = new ChatClient(model, new ApiKeyCredential(credential), openAIOptions);



        var contentGenerationPrompt = $@"
                You are a Mental Health expert with over 20 years of experience. Based on my current mood, {Model.CurrentMood}, give me 10 short-form content pieces (each under 5 minutes) to boost productivity. ";

        if (!Model.IsProductivityMode)
        {
            contentGenerationPrompt = $@"
                You are a Mental Health expert with over 20 years of experience. Based on my current mood, {Model.CurrentMood}, give me 10 short-form content pieces (each under 5 minutes) to help me wind down. ";
        }

        contentGenerationPrompt += $@"Prioritize quick articles, news and upcoming events in Canada that related to my interests. Provide the topic/subject of the article as category. For videos and audio, provide youtube iframes only if they are valid and working. Categorize them as videos, audio, article and provide a minimum 200 word summary of the article. Make sure they are practical, uplifting, and high quality and also related to my interests: {onboardingContext}. Skip articles that do not have a valid sourceurl. DO NOT show me articles that are related to my dislikes such as {dislikeContext}. Respond in structured JSON list format. DO NOT generate explanations - just the raw JSON list";

        string jsonSchema = @"
        {
            ""type"": ""object"",
            ""properties"": {
                ""contentitems"": {
                    ""type"": ""array"",
                    ""items"": {
                        ""type"": ""object"",
                        ""properties"": {
                            ""title"": { ""type"": ""string"" },
                            ""sourceurl"": { ""type"": ""string"" },
                            ""description"": { ""type"": ""string"" },
                            ""summary"": { ""type"": ""string"" },
                            ""contentType"": { ""type"": ""string"" },
                            ""category"": { ""type"" : ""string""}
                        },
                        ""required"": [""title"", ""sourceurl"", ""description"", ""summary"", ""category"", ""contentType""],
                        ""additionalProperties"": false
                    }
                }
            },
            ""required"": [""contentitems""],
            ""additionalProperties"": false
        }
        ";



        Options = new()
            {
                ResponseFormat = ChatResponseFormat.CreateJsonSchemaFormat(
                        jsonSchemaFormatName: "discovery_feed_setup",
                        jsonSchema: BinaryData.FromString(jsonSchema),
                        jsonSchemaIsStrict: true)
            };

        Model.ExperienceChatHistory = new List<ChatMessage>()
        {
            new SystemChatMessage(contentGenerationPrompt)
        };

        ChatCompletion response1 = await Client.CompleteChatAsync(Model.ExperienceChatHistory, Options);


        using JsonDocument structuredJson = JsonDocument.Parse(response1.Content[0].Text);

        JsonElement.ArrayEnumerator contentItemsJson = structuredJson.RootElement.GetProperty("contentitems").EnumerateArray();

        List<ContentItemModel> initialResults = new List<ContentItemModel>();

        foreach (JsonElement contentItem in contentItemsJson)
        {
            ContentItemModel item = new ContentItemModel
                {
                    Title = contentItem.GetProperty("title").ToString(),
                    URL = contentItem.GetProperty("sourceurl").ToString(),
                    Description = contentItem.GetProperty("description").ToString(),
                    Summary = contentItem.GetProperty("summary").ToString(),
                    ContentType = contentItem.GetProperty("contentType").ToString(),
                    Category = contentItem.GetProperty("category").ToString()
                };

            initialResults.Add(item);
        }


        foreach (var item in initialResults)
        {
            bool isItemHasSource = await VectorStoreService.IsUrlValid(item.URL);
            if (isItemHasSource)
            {
                Model.DiscoveryFeed.Add(item);
            }
        }


        StateHasChanged();

        await JSRuntime.InvokeVoidAsync("hideLoader");
        await Task.CompletedTask;
    }


    private async Task SetCurrentMood(string mood)
    {
        await JSRuntime.InvokeVoidAsync("showLoader");
        Model.CurrentMood = mood;
        Model.MoodAudio = string.Empty;

        //Get experience set up based on mood + interests/likes
        await SetupMood();

        //Generate Discovery Feed
        await GenerateDiscoveryFeed();

        StateHasChanged();

        await Task.CompletedTask;
    }

    private async Task ToggleMoodAudio(string state)
    {
        await JSRuntime.InvokeVoidAsync("playMoodAudio", state);
    }


    public class ExperienceViewModel
    {
        public List<ChatMessage>? ExperienceChatHistory { get; set; }
        public string? ExperienceGreeting { get; set; } = "How are you feeling today?";
        public List<string> ExperienceMoods { get; set; } = new List<string>() { "fantastic", "happy", "neutral", "meh", "sad" };
        public string? CurrentMood { get; set; } = "happy";
        public List<ContentItemModel>? DiscoveryFeed { get; set; } = new List<ContentItemModel>();
        public List<ContentItemModel>? LikedPosts { get; set; } = new List<ContentItemModel>();
        public List<ContentItemModel>? DislikedPosts { get; set; } = new List<ContentItemModel>();

        public bool IsProductivityMode { get; set; } = true;
        public string? MoodAudio { get; set; }
    }
}