@page "/experience"
@using Hackathon2025.Abstractions
@using OpenAI
@using OpenAI.Chat
@using System.ClientModel
@using System.Text.Json
@inject OnboardingAgentService AgentService
@inject VectorStoreService VectorStoreService
@inject IConfiguration Configuration;

<PageTitle>Experience</PageTitle>
<div class="mood-setter-wrp">
    @foreach(var mood in Model.ExperienceMoods)
    {
        <button @onclick="() => SetCurrentMood(mood)"><img src='@String.Format("/images/icon-{0}.png", mood)' /></button>
    }
</div>
@if (!string.IsNullOrEmpty(Model.MoodAudio))
{

    <div class="mood-music-wrp">
        @((MarkupString)Model.MoodAudio)
        <button @onclick='() => ToggleMoodAudio("play")' class="__play"><img src="/images/icon-audio.png" /></button>
        <button @onclick='() => ToggleMoodAudio("stop")'  class="__stop __hide"><img src="/images/icon-mute-audio.png" /></button>
    </div>
}

<div class="content-wrp __scrollable">
    @if (Model != null)
    {
        if (Model.DiscoveryFeed != null)
        {
            //present activity gallery
            foreach (var item in Model.DiscoveryFeed)
            {

                <div class="card">
                    <iframe src="@item.URL"  title="@item.Title"></iframe>
                    <div class="row">
                        <div class="col">
                            <p class="title">@item.Title</p>
                            <p class="decription">@item.Description</p>
                        </div>
                    </div>
                    <div class="btns-rate-wrp">
                        <a href="#" class="like" title="Like"></a>
                        <a href="#" class="dislike" title="Dislike"></a>
                    </div>
                </div>
            }
        }

    }
    <LoadingOverlay ShowOnLoadClass="__active" />
</div>

@code {
    public ExperienceViewModel? Model { get; set; }
    public ChatClient? Client { get; set; }
    public ChatCompletionOptions? Options { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new(); //init model


        var timeUtc = DateTime.UtcNow;
        TimeZoneInfo easternZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
        DateTime easternTime = TimeZoneInfo.ConvertTimeFromUtc(timeUtc, easternZone);

        Model.IsProductivityMode = (easternTime.Hour > 8 && easternTime.Hour < 17);


        // await GenerateDiscoveryFeed();

        // await JSRuntime.InvokeVoidAsync("hideLoader");
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // await JSRuntime.InvokeVoidAsync("startTimer");
    }

    private async Task SetupMood()
    {
        var endpoint = Configuration["GithubOpenAI:ChatEndpoint"];
        var credential = Configuration["GithubOpenAI:Token"];
        var model = Configuration["GithubOpenAI:Model"];

        //get user likes & user dislikes from vector DB to add context
        string userOnboardingInterestsContext = "Get all user likes and dislikes";

        Dictionary<string, object> results = await VectorStoreService.QueryOnboardingResultVectorStoreAsync(userOnboardingInterestsContext);

        string onboardingContext = "The user ";

        foreach (var item in results)
        {
            onboardingContext += item.Key + ": " + item.Value.ToString().Replace("[", string.Empty).Replace("]", string.Empty);
        }


        var experienceConfigPrompt = String.Format("You are a Mental Health expert with over 20 years of experience with specialization in mood. Your goal is to recommend a background colour, a song (a youtube iframe embed link to it) that would improve the user's mood when they are feeling {0}. Context from previous interaction is {1}. Based on the provided context, make the best recommendation.", Model.CurrentMood, onboardingContext);


        var openAIOptions = new OpenAIClientOptions()
            {
                Endpoint = new Uri(endpoint)
            };

        Client = new ChatClient(model, new ApiKeyCredential(credential), openAIOptions);

        Model.ExperienceChatHistory = new List<ChatMessage>()
        {
            new SystemChatMessage(experienceConfigPrompt),
            new AssistantChatMessage(Model.ExperienceGreeting),
            new UserChatMessage(Model.CurrentMood)
        };

        string jsonSchema = @"
        {
            ""type"": ""object"",
            ""properties"": {
                ""backgroundcolour"": { ""type"": ""string"" },
                ""song"": { ""type"": ""string"" }
            },
            ""required"": [""backgroundcolour"", ""song""],
            ""additionalProperties"": false
        }
        ";

        Options = new()
            {
                ResponseFormat = ChatResponseFormat.CreateJsonSchemaFormat(
                    jsonSchemaFormatName: "experience_setup",
                    jsonSchema: BinaryData.FromString(jsonSchema),
                    jsonSchemaIsStrict: true)
            };

        ChatCompletion response1 = await Client.CompleteChatAsync(Model.ExperienceChatHistory, Options);


        using JsonDocument structuredJson = JsonDocument.Parse(response1.Content[0].Text);

        var bgColor = structuredJson.RootElement.GetProperty("backgroundcolour").ToString();
        await JSRuntime.InvokeVoidAsync("updateBackgroundColor", bgColor);

        Model.MoodAudio = structuredJson.RootElement.GetProperty("song").ToString();

        //TODO: do something with retrieved items

        StateHasChanged();
        await Task.CompletedTask;
    }


    private async Task GenerateDiscoveryFeed()
    {
        var endpoint = Configuration["GithubOpenAI:ChatEndpoint"];
        var credential = Configuration["GithubOpenAI:Token"];
        var model = Configuration["GithubOpenAI:Model"];

        string userLikesInterests = "Get user's personal interests and professional interests";

        Dictionary<string, object> results = await VectorStoreService.QueryOnboardingResultVectorStoreAsync(userLikesInterests);

        string onboardingContext = String.Empty;

        foreach (var item in results)
        {
            onboardingContext += String.Format("{0}. ", item.Value.ToString().Replace("[", string.Empty).Replace("]", string.Empty));
        }

        var openAIOptions = new OpenAIClientOptions()
        {
            Endpoint = new Uri(endpoint)
        };

        Client = new ChatClient(model, new ApiKeyCredential(credential), openAIOptions);



        var contentGenerationPrompt = $@"
                You are a Mental Health expert with over 20 years of experience. Based on my current mood, {Model.CurrentMood}, give me 3 short-form content pieces (each under 5 minutes) to boost productivity. Prioritize videos, audio clips, or quick articles. Categorize them as videos, audio, article. Make sure they are practical, uplifting, and high quality and also related to my interests: {onboardingContext}";

        if (!Model.IsProductivityMode)
        {
            contentGenerationPrompt = $@"
                You are a Mental Health expert with over 20 years of experience. Based on my current mood, {Model.CurrentMood}, give me 3 short-form content pieces (each under 5 minutes) to help me wind down. Prioritize videos, audio clips, or quick articles. Categorize them as videos, audio, article. Make sure they are practical, uplifting, and high quality and also related to my interests: {onboardingContext}";
        }

        contentGenerationPrompt += "Respond in structured JSON list format. DO NOT generate explanations - just the raw JSON list";

        string jsonSchema = @"
        {
            ""type"": ""object"",
            ""properties"": {
                ""contentitems"": {
                    ""type"": ""array"",
                    ""items"": {
                        ""type"": ""object"",
                        ""properties"": {
                            ""title"": { ""type"": ""string"" },
                            ""sourceurl"": { ""type"": ""string"" },
                            ""description"": { ""type"": ""string"" },
                            ""contentType"": { ""type"": ""string"" }
                        },
                        ""required"": [""title"", ""sourceurl"", ""description"", ""contentType""],
                        ""additionalProperties"": false
                    }
                }
            },
            ""required"": [""contentitems""],
            ""additionalProperties"": false
        }
        ";



        Options = new()
            {
                ResponseFormat = ChatResponseFormat.CreateJsonSchemaFormat(
                        jsonSchemaFormatName: "discovery_feed_setup",
                        jsonSchema: BinaryData.FromString(jsonSchema),
                        jsonSchemaIsStrict: true)
            };

        Model.ExperienceChatHistory = new List<ChatMessage>()
        {
            new SystemChatMessage(contentGenerationPrompt)
        };

        ChatCompletion response1 = await Client.CompleteChatAsync(Model.ExperienceChatHistory, Options);


        using JsonDocument structuredJson = JsonDocument.Parse(response1.Content[0].Text);

        JsonElement.ArrayEnumerator contentItemsJson = structuredJson.RootElement.GetProperty("contentitems").EnumerateArray();

        foreach (JsonElement contentItem in contentItemsJson)
        {
            ContentItemModel item = new ContentItemModel
                {
                    Title = contentItem.GetProperty("title").ToString(),
                    URL = contentItem.GetProperty("sourceurl").ToString(),
                    Description = contentItem.GetProperty("description").ToString(),
                    ContentType = contentItem.GetProperty("contentType").ToString()
                };

            Model.DiscoveryFeed.Add(item);
        }

        StateHasChanged();
        await Task.CompletedTask;
    }


    private async Task SetCurrentMood(string mood)
    {
        Model.CurrentMood = mood;

        //Get experience set up based on mood + interests/likes
        await SetupMood();

        //Generate Discovery Feed
        //await GenerateDiscoveryFeed();

        StateHasChanged();

        await Task.CompletedTask;
    }

    private async Task ToggleMoodAudio(string state)
    {
        await JSRuntime.InvokeVoidAsync("playMoodAudio", state);
    }


    public class ExperienceViewModel
    {
        public List<ChatMessage>? ExperienceChatHistory { get; set; }
        public string? ExperienceGreeting { get; set; } = "How are you feeling today?";
        public List<string> ExperienceMoods { get; set; } = new List<string>() { "fantastic", "happy", "neutral", "meh", "sad" };
        public string? CurrentMood { get; set; } = "happy";
        public List<ContentItemModel>? DiscoveryFeed { get; set; } = new List<ContentItemModel>();



        public bool IsProductivityMode { get; set; } = true;
        public string? MoodAudio { get; set; }
    }
}