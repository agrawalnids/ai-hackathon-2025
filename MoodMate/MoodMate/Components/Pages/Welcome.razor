@page "/tab"

@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@using MoodMate.Abstractions
@inject TeamsUserCredential TeamsUserCredential
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
@inject NavigationManager MyNavigationManager

@inject InterestsAgentService AgentService
@inject VectorStoreService VectorStoreService

<PageTitle>MoodMate</PageTitle>

@if (IsLoading)
{
    <LoadingOverlay ShowOnLoadClass="__active" />
}
else
{
    <div class="content-wrp">
        <h1>Hey There!</h1>

        @if (!IsOnboardingComplete)
        {
            if (!string.IsNullOrEmpty(UserProfileName))
            {
                <p class="align-center mt-4">
                    <a href="/onboarding" class="button"><span>Let's Checkin</span></a>
                </p>
            }
        }
        else
        {
            if (IsExperienceAvailable)
            {
                <p class="align-center mt-4">
                    <a href="/experience" class="button"><span>Let's Checkin</span></a>
                </p>
            }
            else
            {
                <p class="align-center mt-4">
                    It is not break time yet :)
                </p>
            }

        }
    </div>
}

@code {
    private bool IsLoading { get; set; } = true;
    private bool IsOnboardingComplete { get; set; } = false;
    private bool IsExperienceAvailable { get; set; } = false;
    private string UserProfileName { get; set; } = "UserName";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //await localStorage.ClearAsync();

            var lastVisitTimestamp = await localStorage.GetItemAsync<DateTime>("lastVisitTimestamp"); 
            IsExperienceAvailable = (DateTime.UtcNow > lastVisitTimestamp.AddHours(2));

            // Check if onboarding is already complete or not
            var cookieValue = await localStorage.GetItemAsync<string>("onboardingComplete");
            IsOnboardingComplete = cookieValue == "true";

            //Get user profile name
            var user = await TeamsUserCredential.GetUserInfoAsync();
            UserProfileName = user.DisplayName;
            await localStorage.SetItemAsync("profileName", UserProfileName);
            IsLoading = false;

            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("hideLoader");

        }
    }
}